@model ServicioVeterinario
@{ ViewData["Title"] = "Eliminar servicio"; }

<div class="card shadow-sm form-card border-danger">
    <div class="card-body p-4">
        <h2 class="mb-3">Eliminar servicio</h2>
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@Model.Descripcion</dd>
            <dt class="col-sm-4">Precio</dt><dd class="col-sm-8">$ @Model.Precio.ToString("N2")</dd>
            <dt class="col-sm-4">Citas</dt><dd class="col-sm-8">@Model.Citas.Count</dd>
        </dl>

        @if (Model.Citas.Any())
        {
            <div class="alert alert-warning">Este servicio tiene citas registradas y no se puede eliminar.</div>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        }
        else
        {
            <p>¿Seguro que deseas eliminar este servicio?</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Eliminar servicio</button>
                <a asp-action="Index" class="btn btn-link">Cancelar</a>
            </form>
        }
    </div>
</div>
