@model IEnumerable<ServicioVeterinario>
@{ ViewData["Title"] = "Servicios disponibles"; }

<h2 class="mb-4">Servicios disponibles</h2>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay servicios publicados.</p>
}

<div class="row g-3">
    @foreach (var s in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@s.Nombre</h5>
                    <p class="card-text flex-grow-1">@s.Descripcion</p>
                    <p class="fs-5 fw-bold mb-3">$ @s.Precio.ToString("N2")</p>
                    @if (User.IsInRole(RolesApp.Cliente))
                    {
                        <a asp-controller="Citas" asp-action="Create" asp-route-servicioId="@s.Id" class="btn btn-primary">Solicitar cita</a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Inicia sesión para agendar</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
