@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var meses = new[] { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card tarjeta-stat shadow-sm h-100"><div class="card-body">
            <i class="bi bi-clipboard2-pulse"></i>
            <div class="numero mt-2">@Model.TotalServicios</div>
            <div class="text-muted">Servicios veterinarios</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card tarjeta-stat shadow-sm h-100"><div class="card-body">
            <i class="bi bi-heart"></i>
            <div class="numero mt-2">@Model.TotalMascotas</div>
            <div class="text-muted">Mascotas registradas</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card tarjeta-stat shadow-sm h-100"><div class="card-body">
            <i class="bi bi-people"></i>
            <div class="numero mt-2">@Model.TotalUsuarios</div>
            <div class="text-muted">Usuarios</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card tarjeta-stat shadow-sm h-100"><div class="card-body">
            <i class="bi bi-calendar-check"></i>
            <div class="numero mt-2">@Model.TotalCitas</div>
            <div class="text-muted">Citas registradas</div>
        </div></div>
    </div>
    <div class="col-12 col-lg">
        <div class="card tarjeta-stat shadow-sm h-100"><div class="card-body">
            <i class="bi bi-hourglass-split"></i>
            <div class="numero mt-2">@Model.CitasPendientes</div>
            <div class="text-muted">Citas pendientes</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h5 class="mb-0">Citas por mes (@Model.Anio)</h5>
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <select name="anio" class="form-select form-select-sm" aria-label="Año" onchange="this.form.submit()"
                        asp-items="@Model.AniosDisponibles.Select(a => new SelectListItem(a.ToString(), a.ToString(), a == Model.Anio))">
                </select>
            </form>
        </div>
        <canvas id="graficoCitas" height="110"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const etiquetas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(meses));
        const valores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CitasPorMes));

        new Chart(document.getElementById('graficoCitas'), {
            type: 'bar',
            data: {
                labels: etiquetas,
                datasets: [{
                    label: 'Citas',
                    data: valores,
                    backgroundColor: '#1f6f5c',
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
