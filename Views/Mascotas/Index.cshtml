@model IEnumerable<Mascota>
@{ ViewData["Title"] = "Mis mascotas"; }

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="mb-0">Mis mascotas</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Registrar mascota</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Raza</th>
                <th class="text-center">Citas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Aún no registras mascotas. Usa “Registrar mascota” para empezar.</td></tr>
            }
            @foreach (var m in Model)
            {
                <tr>
                    <td class="fw-semibold">@m.Nombre</td>
                    <td>@m.Especie</td>
                    <td>@m.Raza</td>
                    <td class="text-center">@m.Citas.Count</td>
                    <td class="text-end">
                        <a asp-controller="Citas" asp-action="Create" class="btn btn-sm btn-outline-primary">Solicitar cita</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
